}

Layer("/DEFAULT/defaultLayer") {
    {RdlMeshGeometry("/grid/mesh_0"), "", UsdPreviewSurface("/materials/usdpreviewsurface1/usdpreviewsurface1"), LightSet("LightSet3AC404"), undef(), undef(), LightFilterSet("/DEFAULT/emptyLightFilterSet"), undef(), undef()},
}

UsdPreviewSurface("/materials/usdpreviewsurface1/usdpreviewsurface1") {
