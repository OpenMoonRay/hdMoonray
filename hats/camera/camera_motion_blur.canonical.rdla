    ["emissiveColor"] = bind(undef(), Rgb(1, 1, 1)),
}

EnvLight("/defaultLight") {
}

LightFilterSet("/DEFAULT/emptyLightFilterSet") {
}

LightSet("LightSet3AC404") {
    EnvLight("/defaultLight"),
}

PerspectiveCamera("/camera") {
    ["node_xform"] = blur(Mat4(0.44838321609003218, 0.89384142415126366, -0, 0, -0.89384142415126366, 0.44838321609003218, 0, 0, 0, -0, 1, 0, 0, 0.59200000000000041, 10, 1), Mat4(0.34318784763569554, 0.93926678916864648, -0, 0, -0.93926678916864648, 0.34318784763569554, 0, 0, 0, -0, 1, 0, -2.7755575615628914e-17, 0.44400000000000028, 10, 1)),
    ["far"] = 1000000,
    ["focal"] = blur(0.5, 0.5),
    ["film_width_aperture"] = 0.209549993,
}

PerspectiveCamera("/DEFAULT/primaryCamera") {
    ["node_xform"] = blur(Mat4(0.44838321609003218, 0.89384142415126366, -0, 0, -0.89384142415126366, 0.44838321609003218, 0, 0, 0, -0, 1, 0, 0, 0.59200000000000041, 10, 1), Mat4(0.34318784763569554, 0.93926678916864648, -0, 0, -0.93926678916864648, 0.34318784763569554, 0, 0, 0, -0, 1, 0, -2.7755575615628914e-17, 0.44400000000000028, 10, 1)),
    ["far"] = 1000000,
