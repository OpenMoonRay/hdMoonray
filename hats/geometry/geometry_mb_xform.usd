#usda 1.0
(
    startTimeCode = 1
    endTimeCode = 8
)

def Sphere "s0"
{
    float3 xformOp:translate = (-2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    
}
def Sphere "s1"
{
    float3 xformOp:translate = (2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "s"
{
    # at frame 4, with open=-0.25 and close=+0.25, blur should start at (-2,0,0) and go to (+2,0,0)
    float3 xformOp:translate.timeSamples = {
               3: (-8, 0, 0),
               4: (0, 0, 0),
               5: (8, 0, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Camera "camera"
{
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float3 xformOp:translate = (0, 0, 50)
    double shutter:open = -0.25
    double shutter:close = 0.25
}

def DomeLight "defaultLight"
{
}