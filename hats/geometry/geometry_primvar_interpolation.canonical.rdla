SceneVariables {
    ["camera"] = PerspectiveCamera("/DEFAULT/primaryCamera"),
    ["layer"] = Layer("/DEFAULT/defaultLayer"),
    ["image_width"] = 960,
    ["image_height"] = 700,
    ["enable_motion_blur"] = false,
}

AttributeMap("/DEFAULT/displayColorMap") {
    ["default_value"] = bind(undef(), Rgb(0.5, 0.5, 0.5)),
