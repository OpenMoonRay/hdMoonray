    ["is_subd"] = false,
    ["subd_fvar_linear"] = "corners plus1",
    ["primitive_attributes"] = { UserData("/constant.primvars:displayColor"), UserData("/constant.primvars:primId")},
    ["smooth_normal"] = false,
}

